From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MiBox4-LibreELEC contributors
Date: Fri, 28 Aug 2026 16:00:00 +0800
Subject: [PATCH] emmctool: add bootloader-preserving Mi Box 4 install

The MDZ-21-AA has a signed vendor boot container at user-area offset 0x200
and an Amlogic MPT at 4 MiB. A normal whole-image write destroys that boot
chain, while a generic box image contains no replacement U-Boot.

Add a dedicated install action which migrates the boot files from the
currently running USB image. Keep the first 512 MiB intact, create an MBR
plus BOOT/DISK partitions after that boundary, and update uEnv.ini for the
Mi Box 4 DTB and new filesystem labels.

Before changing the disk, save the preserved user-area prefix and both eMMC
boot hardware areas to USB /storage. Disable unrelated destructive actions
on this device. Also correct the existing backup redirection typo.

Signed-off-by: MiBox4-LibreELEC contributors
---
 packages/tools/emmctool/scripts/emmctool | 181 ++++++++++++++++++++++-
 1 file changed, 178 insertions(+), 3 deletions(-)

diff --git a/packages/tools/emmctool/scripts/emmctool b/packages/tools/emmctool/scripts/emmctool
index cd76b47..6939ad7 100755
--- a/packages/tools/emmctool/scripts/emmctool
+++ b/packages/tools/emmctool/scripts/emmctool
@@ -3,15 +3,25 @@
 # SPDX-License-Identifier: GPL-2.0
 # Copyright (C) 2019-present Team LibreELEC (https://libreelec.tv)
 
+set -o pipefail
+
 # ** !!! WARNING !!! WARNING !!! WARNING !!! WARNING !!! WARNING !!! **
 # This script is not supported on generic box devices. If you choose to
 # modify it to run on other hardware and you brick your device you will
 # receive no support to restore your device. You have been warned!
 
 do_backup(){
+  if [ -z "${2}" ]; then
+    echo "error: backup filename is missing"
+    exit 1
+  fi
   do_umount
   echo "info: compressing ${EMMC} to ${2}, this will take time"
-  dd if="${EMMC}" | gzip > of="${2}"
+  if ! dd if="${EMMC}" | gzip > "${2}"; then
+    rm -f "${2}"
+    echo "error: backup failed"
+    exit 1
+  fi
   echo "info: compressing completed"
 }
 
@@ -138,6 +148,160 @@ do_umount(){
   done
 }
 
+mibox4_fail(){
+  echo "error: $*"
+  exit 1
+}
+
+mibox4_validate(){
+  [ "$(dtname)" = "xiaomi,mibox4" ] || \
+    mibox4_fail "the Mi Box 4 installer was invoked on $(dtname)"
+
+  [ -f /flash/KERNEL ] || mibox4_fail "/flash/KERNEL is missing"
+  [ -f /flash/s905_autoscript ] || \
+    mibox4_fail "/flash/s905_autoscript is missing"
+  [ -f /flash/emmc_autoscript ] || \
+    mibox4_fail "/flash/emmc_autoscript is missing"
+  [ -f /flash/amlogic/meson-gxlx-mibox4.dtb ] || \
+    mibox4_fail "the Mi Box 4 DTB is missing from /flash/amlogic"
+
+  BOOT_MAGIC=$(dd if="${EMMC}" bs=1 skip=528 count=4 2>/dev/null)
+  MPT_MAGIC=$(dd if="${EMMC}" bs=1 skip=4194304 count=3 2>/dev/null)
+  [ "${BOOT_MAGIC}" = "@AML" ] || \
+    mibox4_fail "signed Amlogic boot container not found at 0x210"
+  [ "${MPT_MAGIC}" = "MPT" ] || \
+    mibox4_fail "Amlogic MPT not found at 4 MiB"
+
+  EMMC_SIZE=$(blockdev --getsize64 "${EMMC}")
+  [ "${EMMC_SIZE}" -ge 3221225472 ] || \
+    mibox4_fail "eMMC is smaller than the 3 GiB safety minimum"
+
+  AVAILABLE_KIB=$(df -Pk /storage | awk 'NR == 2 { print $4 }')
+  [ -n "${AVAILABLE_KIB}" ] || \
+    mibox4_fail "could not determine free space on USB /storage"
+  [ "${AVAILABLE_KIB}" -ge 614400 ] || \
+    mibox4_fail "USB /storage needs at least 600 MiB free for the backup"
+}
+
+mibox4_backup(){
+  BACKUP_STAMP=$(date +%Y%m%d-%H%M%S)
+  BACKUP_PREFIX="/storage/mibox4-emmc-${BACKUP_STAMP}"
+  BACKUP_USER="${BACKUP_PREFIX}-first512M.img.gz"
+
+  echo "info: backing up the original first 512 MiB to ${BACKUP_USER}"
+  if ! dd if="${EMMC}" bs=1M count=512 | gzip > "${BACKUP_USER}"; then
+    rm -f "${BACKUP_USER}"
+    mibox4_fail "could not create the mandatory boot-chain backup"
+  fi
+
+  for area in boot0 boot1; do
+    device="${EMMC}${area}"
+    backup="${BACKUP_PREFIX}-${area}.img.gz"
+    if [ -b "${device}" ]; then
+      echo "info: backing up ${device} to ${backup}"
+      if ! dd if="${device}" | gzip > "${backup}"; then
+        rm -f "${backup}"
+        mibox4_fail "could not back up ${device}"
+      fi
+    fi
+  done
+  sync
+}
+
+mibox4_wait_partitions(){
+  partprobe "${EMMC}" 2>/dev/null || true
+  udevadm settle 2>/dev/null || true
+  count=0
+  while [ ! -b "${EMMC}p1" ] || [ ! -b "${EMMC}p2" ]; do
+    count=$((count + 1))
+    [ "${count}" -lt 10 ] || \
+      mibox4_fail "kernel did not discover the new eMMC partitions"
+    sleep 1
+  done
+}
+
+mibox4_patch_boot_config(){
+  root="$1"
+  if [ -f "${root}/uEnv.ini" ]; then
+    sed -i \
+      -e 's|^dtb_name=.*|dtb_name=/amlogic/meson-gxlx-mibox4.dtb|' \
+      -e 's|boot=[^ ]*|boot=LABEL=BOOT|' \
+      -e 's|disk=[^ ]*|disk=LABEL=DISK|' \
+      "${root}/uEnv.ini"
+  fi
+  if [ -f "${root}/extlinux/extlinux.conf" ]; then
+    sed -i \
+      -e 's|boot=[^ ]*|boot=LABEL=BOOT|' \
+      -e 's|disk=[^ ]*|disk=LABEL=DISK|' \
+      "${root}/extlinux/extlinux.conf"
+  fi
+}
+
+do_mibox4_install(){
+  mibox4_validate
+
+  echo ""
+  echo "WARNING: This permanently replaces Android system/data with LibreELEC."
+  echo "The signed bootloader, environment and recovery/boot areas are preserved."
+  echo "A mandatory recovery backup will be written to the USB /storage volume."
+  echo "Type MIBOX4 (uppercase) to continue:"
+  read -r answer
+  [ "${answer}" = "MIBOX4" ] || mibox4_fail "installation cancelled"
+
+  do_umount
+  mibox4_backup
+
+  echo "info: creating an MBR and eMMC BOOT/DISK partitions"
+  parted -s "${EMMC}" mklabel msdos || mibox4_fail "could not create MBR"
+  parted -s "${EMMC}" unit MiB mkpart primary fat32 512 1024 || \
+    mibox4_fail "could not create BOOT partition"
+  parted -s "${EMMC}" set 1 boot on || mibox4_fail "could not flag BOOT"
+  parted -s "${EMMC}" unit MiB mkpart primary ext4 1024 100% || \
+    mibox4_fail "could not create DISK partition"
+
+  # parted owns sector 0 only. Restore sectors 1..512 MiB so BL2, MPT,
+  # keys, environment and the vendor recovery/boot images remain byte-exact.
+  echo "info: restoring the preserved boot-chain area"
+  if ! gzip -dc "${BACKUP_USER}" | \
+      dd of="${EMMC}" bs=512 skip=1 seek=1 count=1048575 conv=notrunc; then
+    mibox4_fail "could not restore the preserved boot-chain area"
+  fi
+  sync
+  mibox4_wait_partitions
+
+  echo "info: formatting ${EMMC}p1 as BOOT"
+  mkfs.fat -F 32 -n BOOT "${EMMC}p1" || mibox4_fail "BOOT format failed"
+  echo "info: formatting ${EMMC}p2 as DISK"
+  mkfs.ext4 -F -L DISK "${EMMC}p2" || mibox4_fail "DISK format failed"
+  sleep 1
+  do_umount
+
+  install_root=/tmp/emmctool-mibox4
+  mkdir -p "${install_root}/boot" "${install_root}/disk"
+  mount "${EMMC}p1" "${install_root}/boot" || \
+    mibox4_fail "could not mount BOOT"
+  mount "${EMMC}p2" "${install_root}/disk" || {
+    umount "${install_root}/boot"
+    mibox4_fail "could not mount DISK"
+  }
+
+  echo "info: copying the running USB boot files to eMMC"
+  if ! cp -R /flash/. "${install_root}/boot/"; then
+    umount "${install_root}/disk" "${install_root}/boot"
+    mibox4_fail "could not copy boot files"
+  fi
+  mibox4_patch_boot_config "${install_root}/boot"
+  sync
+  umount "${install_root}/disk" "${install_root}/boot"
+  rmdir "${install_root}/disk" "${install_root}/boot" "${install_root}"
+
+  echo ""
+  echo "info: Mi Box 4 eMMC installation completed"
+  echo "info: recovery backup prefix is ${BACKUP_PREFIX}"
+  echo "info: shut down, remove the USB drive, then power-cycle the box"
+  echo ""
+}
+
 do_writeprotect(){
   echo  "info: disabling emmc write protection"
   echo 0 > "/sys/block/${EMMC}boot0/force_ro"
@@ -194,6 +358,7 @@ do_help(){
   echo "                (r)esize              : resize the storage partition to 100%"
   echo "                (s)storage            : convert emmc for use as /storage (boot from sdcard)"
   echo "                (z)ero                : zero (erase/wipe) the eMMC module"
+  echo "                (x)install            : install from USB on Xiaomi Mi Box 4"
   echo "                (h)elp                : displays this help message"
   echo ""
 }
@@ -207,7 +372,7 @@ if [ -z "${EMMC}" ]; then
 fi
 
 case $(dtname) in
-  azw*|bananapi*|friendlyarm*|hardkernel*|khadas*|libretech*|radxa*|wetek*)
+  azw*|bananapi*|friendlyarm*|hardkernel*|khadas*|libretech*|radxa*|wetek*|xiaomi,mibox4)
     if [ "${BOOT}" = "${EMMC}" ]; then
       do_info
       echo "Your device is booted from the eMMC module!"
@@ -222,8 +387,15 @@ case $(dtname) in
     ;;
 esac
 
+if [ "$(dtname)" = "xiaomi,mibox4" ]; then
+  case "${1}" in
+    ""|backup|b|info|i|install|x|help|h) ;;
+    *) mibox4_fail "Mi Box 4 only supports info, backup and install" ;;
+  esac
+fi
+
 case "${1}" in
-  backup)
+  backup|b)
     do_backup "$@"
     ;;
   detect|d)
@@ -249,6 +421,9 @@ case "${1}" in
   zero|z)
     do_zero
     ;;
+  install|x)
+    do_mibox4_install
+    ;;
   *)
     do_info
     do_help
-- 
2.51.0


