From 0ac2788f2bae2dceb2c388cab52aef8871b58ce8 Mon Sep 17 00:00:00 2001
From: YuChia Kan <raspberrykan@stu.hqu.edu.cn>
Date: Mon, 31 Aug 2026 18:10:48 +0800
Subject: [PATCH 5/6] Amlogic: wire Mi Box 4 into the image build

---
 projects/Amlogic/bootloader/mkimage | 2 +-
 scripts/uboot_helper                | 4 ++++
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/projects/Amlogic/bootloader/mkimage b/projects/Amlogic/bootloader/mkimage
index 282600b..61be37d 100644
--- a/projects/Amlogic/bootloader/mkimage
+++ b/projects/Amlogic/bootloader/mkimage
@@ -74,7 +74,7 @@ case "${UBOOT_SYSTEM}" in
     mkimage_extlinux_fdtdir
     mkimage_dtb
     ;;
-  bananapi*|khadas*|lafrite|lepotato|nanopi-k2|odroid*|radxa*|wetek*)
+  bananapi*|khadas*|lafrite|lepotato|mibox4|nanopi-k2|odroid*|radxa*|wetek*)
     mkimage_uboot
     mkimage_extlinux
     mkimage_dtb
diff --git a/scripts/uboot_helper b/scripts/uboot_helper
index 4693741..691204a 100755
--- a/scripts/uboot_helper
+++ b/scripts/uboot_helper
@@ -204,6 +204,10 @@ devices = \
         'dtb': 'meson-gxl-s905x-libretech-cc.dtb',
         'config': 'libretech-cc_defconfig'
       },
+      'mibox4': {
+        'dtb': 'meson-gxlx-mibox4.dtb',
+        'config': 'mibox4_defconfig'
+      },
       'nanopi-k2': {
         'dtb': 'meson-gxbb-nanopi-k2.dtb',
         'config': 'nanopi-k2_defconfig'
-- 
