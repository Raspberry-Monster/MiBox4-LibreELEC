From 4b0d1a51b183ebafa6a1ee2f84bff642bf078373 Mon Sep 17 00:00:00 2001
From: MiBox4-LibreELEC contributors <noreply@example.com>
Date: Sun, 30 Aug 2026 01:38:20 +0800
Subject: [PATCH 1/3] Amlogic: add direct-boot Mi Box 4 U-Boot

---
 projects/Amlogic/bootloader/install           |   4 +-
 projects/Amlogic/bootloader/mkimage           |  12 +-
 .../u-boot-0003-LOCAL-add-xiaomi-mibox4.patch | 136 ++++++++++++++++++
 scripts/uboot_helper                          |   2 +-
 4 files changed, 140 insertions(+), 14 deletions(-)
 create mode 100644 projects/Amlogic/patches/u-boot/u-boot-0003-LOCAL-add-xiaomi-mibox4.patch

diff --git a/projects/Amlogic/bootloader/install b/projects/Amlogic/bootloader/install
index 1b6be99d7eeff6db25f941c4be5099a21044c0f5..a6f2c17b56634d77eb4e54321a4baadea8fcf1e5 100644
--- a/projects/Amlogic/bootloader/install
+++ b/projects/Amlogic/bootloader/install
@@ -9,7 +9,7 @@ mkdir -p "${DESTDIR}"
 FIPDIR="$(get_build_dir amlogic-boot-fip)"
 
 case "${UBOOT_SYSTEM}" in
-  box|mibox4|"")
+  box|"")
     # no-op, use vendor bootloader
     ;;
   *)
@@ -25,7 +25,7 @@ rm -rf "${INSTALL}"/usr/share/bootloader/u-boot*
 
 # Install u-boot
 mkdir -p "${INSTALL}/usr/share/bootloader"
-if [ "${UBOOT_SYSTEM}" != "box" ] && [ "${UBOOT_SYSTEM}" != "mibox4" ]; then
+if [ "${UBOOT_SYSTEM}" != "box" ]; then
   if [ -f "${DESTDIR}/u-boot.bin.sd.bin" ]; then
     cp -av "${DESTDIR}/u-boot.bin.sd.bin" "${INSTALL}/usr/share/bootloader"
     # If target/u-boot exists, cache the signed bin
diff --git a/projects/Amlogic/bootloader/mkimage b/projects/Amlogic/bootloader/mkimage
index 2839e06b3b5623f03fe56e319e438c7d249496eb..61be37d9d57aa22529fb551f85ca446824379015 100644
--- a/projects/Amlogic/bootloader/mkimage
+++ b/projects/Amlogic/bootloader/mkimage
@@ -69,22 +69,12 @@ case "${UBOOT_SYSTEM}" in
     mkimage_bootini
     mkimage_dtb
     ;;
-  mibox4)
-    # Keep the production image on Xiaomi's early boot chain until the
-    # board-specific mainline BL33 has completed recoverable hardware testing.
-    # Package only its fixed boot configuration and vendor-U-Boot autoscripts.
-    mkimage_uEnv
-    mkimage_autoscripts
-    mkimage_bootini
-    mkimage_extlinux
-    mkimage_dtb
-    ;;
   odroid-n2|odroid-c4)
     mkimage_uboot
     mkimage_extlinux_fdtdir
     mkimage_dtb
     ;;
-  bananapi*|khadas*|lafrite|lepotato|nanopi-k2|odroid*|radxa*|wetek*)
+  bananapi*|khadas*|lafrite|lepotato|mibox4|nanopi-k2|odroid*|radxa*|wetek*)
     mkimage_uboot
     mkimage_extlinux
     mkimage_dtb
diff --git a/projects/Amlogic/patches/u-boot/u-boot-0003-LOCAL-add-xiaomi-mibox4.patch b/projects/Amlogic/patches/u-boot/u-boot-0003-LOCAL-add-xiaomi-mibox4.patch
new file mode 100644
index 0000000000000000000000000000000000000000..d08b2c667a466ec04feb3284e9ca8b5e98e85ff8
--- /dev/null
+++ b/projects/Amlogic/patches/u-boot/u-boot-0003-LOCAL-add-xiaomi-mibox4.patch
@@ -0,0 +1,136 @@
