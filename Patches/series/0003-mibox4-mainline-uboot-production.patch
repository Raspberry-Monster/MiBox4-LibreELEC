From ea0b194ff1da829bc01a75dee7792430562bda66 Mon Sep 17 00:00:00 2001
From: YuChia Kan <raspberrykan@stu.hqu.edu.cn>
Date: Sun, 30 Aug 2026 01:14:23 +0800
Subject: [PATCH 3/5] Amlogic: ship production Mi Box 4 Mainline BL33

Signed-off-by: YuChia Kan <raspberrykan@stu.hqu.edu.cn>
---
 projects/Amlogic/bootloader/install           |  12 +-
 projects/Amlogic/bootloader/mkimage           |  17 ++-
 projects/Amlogic/bootloader/release           |   4 +
 .../u-boot-0003-LOCAL-add-xiaomi-mibox4.patch | 136 ++++++++++++++++++
 scripts/uboot_helper                          |   2 +-
 5 files changed, 165 insertions(+), 6 deletions(-)
 create mode 100644 projects/Amlogic/patches/u-boot/u-boot-0003-LOCAL-add-xiaomi-mibox4.patch

diff --git a/projects/Amlogic/bootloader/install b/projects/Amlogic/bootloader/install
index 1b6be99d7eeff6db25f941c4be5099a21044c0f5..659d67f40e1e2228e4ca80f8d9ea24972feaf386 100644
--- a/projects/Amlogic/bootloader/install
+++ b/projects/Amlogic/bootloader/install
@@ -10,7 +10,8 @@ FIPDIR="$(get_build_dir amlogic-boot-fip)"
 
 case "${UBOOT_SYSTEM}" in
   box|mibox4|"")
-    # no-op, use vendor bootloader
+    # box uses the vendor bootloader. Mi Box 4 keeps the vendor early chain
+    # and packages the raw Mainline BL33 below as u-boot.ext.
     ;;
   *)
     mkdir "${DESTDIR}/tmp"
@@ -25,7 +26,14 @@ rm -rf "${INSTALL}"/usr/share/bootloader/u-boot*
 
 # Install u-boot
 mkdir -p "${INSTALL}/usr/share/bootloader"
-if [ "${UBOOT_SYSTEM}" != "box" ] && [ "${UBOOT_SYSTEM}" != "mibox4" ]; then
+if [ "${UBOOT_SYSTEM}" = "mibox4" ]; then
+  if [ ! -f "${PKG_BUILD}/u-boot.bin" ]; then
+    echo "Missing Mi Box 4 Mainline BL33: ${PKG_BUILD}/u-boot.bin" >&2
+    exit 1
+  fi
+  cp -av "${PKG_BUILD}/u-boot.bin" \
+    "${INSTALL}/usr/share/bootloader/u-boot.ext"
+elif [ "${UBOOT_SYSTEM}" != "box" ]; then
   if [ -f "${DESTDIR}/u-boot.bin.sd.bin" ]; then
     cp -av "${DESTDIR}/u-boot.bin.sd.bin" "${INSTALL}/usr/share/bootloader"
     # If target/u-boot exists, cache the signed bin
diff --git a/projects/Amlogic/bootloader/mkimage b/projects/Amlogic/bootloader/mkimage
index 2839e06b3b5623f03fe56e319e438c7d249496eb..8d37b540d02ce5da4069af6e5715b19d37e9cc44 100644
--- a/projects/Amlogic/bootloader/mkimage
+++ b/projects/Amlogic/bootloader/mkimage
@@ -9,6 +9,12 @@ mkimage_uboot(){
   dd if="$INSTALL/usr/share/bootloader/u-boot.bin.sd.bin" of="$DISK" conv=fsync,notrunc bs=512 skip=1 seek=1 >"$SAVE_ERROR" 2>&1 || show_error
 }
 
+mkimage_uboot_ext(){
+  echo "image: copying Mi Box 4 Mainline BL33 as u-boot.ext"
+  mcopy -o "${RELEASE_DIR}/3rdparty/bootloader/u-boot.ext" \
+    ::/u-boot.ext >"$SAVE_ERROR" 2>&1 || show_error
+}
+
 mkimage_autoscripts(){
   echo "image: copying autoscript files"
   mcopy -s -o ${RELEASE_DIR}/3rdparty/bootloader/*script ::
@@ -70,13 +76,18 @@ case "${UBOOT_SYSTEM}" in
     mkimage_dtb
     ;;
   mibox4)
-    # Keep the production image on Xiaomi's early boot chain until the
-    # board-specific mainline BL33 has completed recoverable hardware testing.
-    # Package only its fixed boot configuration and vendor-U-Boot autoscripts.
+    # Xiaomi's BL2/BL30/BL31 and vendor U-Boot remain the recoverable early
+    # chain. s905_autoscript chainloads this image's Mainline BL33.
     mkimage_uEnv
     mkimage_autoscripts
     mkimage_bootini
+    if [ -n "${EXTRA_CMDLINE}" ]; then
+      EXTRA_CMDLINE="${EXTRA_CMDLINE} mibox4_bl33=mainline"
+    else
+      EXTRA_CMDLINE="mibox4_bl33=mainline"
+    fi
     mkimage_extlinux
+    mkimage_uboot_ext
     mkimage_dtb
     ;;
   odroid-n2|odroid-c4)
diff --git a/projects/Amlogic/bootloader/release b/projects/Amlogic/bootloader/release
index 641fccd9a43091fa67e320cbfffd31540828ddb9..bba92a70a600a301e76a0dd4a07b7dac025fd39a 100644
--- a/projects/Amlogic/bootloader/release
+++ b/projects/Amlogic/bootloader/release
@@ -7,6 +7,10 @@ DSTDIR="$RELEASE_DIR/3rdparty/bootloader"
 mkdir -p "$DSTDIR"
   cp -a "$SRCDIR"/*.scr "$SRCDIR"/*script "$DSTDIR"
 
+  if [ "${UBOOT_SYSTEM}" = "mibox4" ]; then
+    cp -av "$SRCDIR/u-boot.ext" "$DSTDIR/u-boot.ext"
+  fi
+
   if find_file_path "bootloader/${UBOOT_SYSTEM}.ini"; then
     cp -av "${FOUND_PATH}" "$DSTDIR/boot.ini"
   fi
diff --git a/projects/Amlogic/patches/u-boot/u-boot-0003-LOCAL-add-xiaomi-mibox4.patch b/projects/Amlogic/patches/u-boot/u-boot-0003-LOCAL-add-xiaomi-mibox4.patch
new file mode 100644
index 0000000000000000000000000000000000000000..d08b2c667a466ec04feb3284e9ca8b5e98e85ff8
--- /dev/null
+++ b/projects/Amlogic/patches/u-boot/u-boot-0003-LOCAL-add-xiaomi-mibox4.patch
@@ -0,0 +1,136 @@
+diff --git a/configs/mibox4_defconfig b/configs/mibox4_defconfig
+new file mode 100644
+index 0000000..ecff30f
+--- /dev/null
++++ b/configs/mibox4_defconfig
+@@ -0,0 +1,52 @@
++CONFIG_ARM=y
++CONFIG_ARCH_MESON=y
++CONFIG_TEXT_BASE=0x01000000
++CONFIG_NR_DRAM_BANKS=1
++CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
++CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x20000000
++CONFIG_ENV_SIZE=0x2000
++CONFIG_ENV_IS_NOWHERE=y
++CONFIG_BOOTCOMMAND="setenv boot_targets usb0 mmc0; run distro_bootcmd"
++CONFIG_DM_GPIO=y
++CONFIG_DEFAULT_DEVICE_TREE="amlogic/meson-gxlx-mibox4"
++CONFIG_OF_LIBFDT_OVERLAY=y
++CONFIG_DM_RESET=y
++CONFIG_MESON_GXL=y
++CONFIG_SYS_LOAD_ADDR=0x1000000
++CONFIG_DEBUG_UART_BASE=0xc81004c0
++CONFIG_DEBUG_UART_CLOCK=24000000
++CONFIG_IDENT_STRING=" MiBox4"
++CONFIG_DEBUG_UART=y
++CONFIG_REMAKE_ELF=y
++CONFIG_FIT=y
++CONFIG_FIT_SIGNATURE=y
++CONFIG_FIT_VERBOSE=y
++CONFIG_LEGACY_IMAGE_FORMAT=y
++CONFIG_OF_BOARD_SETUP=y
++CONFIG_CONSOLE_MUX=y
++# CONFIG_DISPLAY_CPUINFO is not set
++CONFIG_SYS_MAXARGS=32
++# CONFIG_CMD_BDI is not set
++# CONFIG_CMD_IMI is not set
++CONFIG_CMD_GPIO=y
++# CONFIG_CMD_LOADS is not set
++CONFIG_CMD_MMC=y
++CONFIG_CMD_USB=y
