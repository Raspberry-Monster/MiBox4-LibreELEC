++CONFIG_CMD_REGULATOR=y
++CONFIG_OF_CONTROL=y
++CONFIG_SYS_RELOC_GD_ENV_ADDR=y
++CONFIG_MMC_MESON_GX=y
++CONFIG_MESON_GXL_USB_PHY=y
++CONFIG_PINCTRL=y
++CONFIG_PINCTRL_MESON_GXL=y
++CONFIG_DM_REGULATOR=y
++CONFIG_DM_REGULATOR_FIXED=y
++CONFIG_DEBUG_UART_ANNOUNCE=y
++CONFIG_DEBUG_UART_SKIP_INIT=y
++CONFIG_MESON_SERIAL=y
++CONFIG_USB=y
++CONFIG_USB_XHCI_HCD=y
++CONFIG_USB_XHCI_DWC3=y
++CONFIG_USB_DWC3=y
++CONFIG_USB_DWC3_MESON_GXL=y
+diff --git a/dts/upstream/src/arm64/amlogic/meson-gxlx-mibox4.dts b/dts/upstream/src/arm64/amlogic/meson-gxlx-mibox4.dts
+new file mode 100644
+index 0000000..834ce93
+--- /dev/null
++++ b/dts/upstream/src/arm64/amlogic/meson-gxlx-mibox4.dts
+@@ -0,0 +1,55 @@
++// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
++/*
++ * Xiaomi Mi Box 4 (MDZ-21-AA)
++ *
++ * The board is based on the GXLX/S905L P271 design and has 2 GiB RAM,
++ * soldered eMMC, one USB host port, and no Ethernet or SD-card connector.
++ */
++
++/dts-v1/;
++
++#include "meson-gxl-s905x.dtsi"
++#include "meson-gx-p23x-q20x.dtsi"
++
++/ {
++	compatible = "xiaomi,mibox4", "amlogic,p271", "amlogic,s905l",
++		     "amlogic,meson-gxlx";
++	model = "Xiaomi Mi Box 4 (MDZ-21-AA)";
++
++	memory@0 {
++		device_type = "memory";
++		reg = <0x0 0x0 0x0 0x80000000>;
++	};
++};
++
++&ethmac {
++	status = "disabled";
++};
++
++/* The RTL8723DS SDIO function is not required by U-Boot. */
++&sd_emmc_a {
++	status = "disabled";
++};
++
++/* There is no external SD-card slot. */
++&sd_emmc_b {
++	status = "disabled";
++};
++
++&sd_emmc_c {
++	status = "okay";
++	bus-width = <8>;
++	non-removable;
++	cap-mmc-highspeed;
++	mmc-ddr-1_8v;
++	mmc-hs200-1_8v;
++};
++
++&uart_AO {
++	status = "okay";
++};
++
++&usb {
++	status = "okay";
++	dr_mode = "host";
++};
+diff --git a/arch/arm/dts/meson-gxlx-mibox4-u-boot.dtsi b/arch/arm/dts/meson-gxlx-mibox4-u-boot.dtsi
+new file mode 100644
+index 0000000..f15e7e7
+--- /dev/null
++++ b/arch/arm/dts/meson-gxlx-mibox4-u-boot.dtsi
+@@ -0,0 +1,11 @@
++// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
++
++#include "meson-gxl-u-boot.dtsi"
++
++&sd_emmc_c {
++	bootph-all;
++};
++
++&uart_AO {
++	bootph-all;
++};
diff --git a/scripts/uboot_helper b/scripts/uboot_helper
index 0ae343a481aa31949c8c767893b3fc1d91dec805..691204a57491f9919087907796a74f2d169e6999 100755
--- a/scripts/uboot_helper
+++ b/scripts/uboot_helper
@@ -206,7 +206,7 @@ devices = \
       },
       'mibox4': {
         'dtb': 'meson-gxlx-mibox4.dtb',
-        'config': 'p212_defconfig'
+        'config': 'mibox4_defconfig'
       },
       'nanopi-k2': {
         'dtb': 'meson-gxbb-nanopi-k2.dtb',
