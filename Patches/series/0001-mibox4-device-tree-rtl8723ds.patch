From d6a7fab0769dd43c5e81e3094fc8234c2c4fe331 Mon Sep 17 00:00:00 2001
From: YuChia Kan <raspberrykan@stu.hqu.edu.cn>
Date: Sun, 30 Aug 2026 01:14:23 +0800
Subject: [PATCH 1/5] Amlogic: add Xiaomi Mi Box 4 with RTL8723DS

Signed-off-by: YuChia Kan <raspberrykan@stu.hqu.edu.cn>
---
 projects/Amlogic/bootloader/install           |   4 +-
 projects/Amlogic/bootloader/mkimage           |  10 ++
 projects/Amlogic/config/kernel-firmware.dat   |   1 +
 ...rm64-dts-add-xiaomi-mibox4-rtl8723ds.patch | 139 ++++++++++++++++++
 projects/Amlogic/linux/linux.aarch64.conf     |   2 +-
 scripts/uboot_helper                          |   4 +
 6 files changed, 157 insertions(+), 3 deletions(-)
 create mode 100644 projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0098-LOCAL-arm64-dts-add-xiaomi-mibox4-rtl8723ds.patch

diff --git a/projects/Amlogic/bootloader/install b/projects/Amlogic/bootloader/install
index a6f2c17b56634d77eb4e54321a4baadea8fcf1e5..1b6be99d7eeff6db25f941c4be5099a21044c0f5 100644
--- a/projects/Amlogic/bootloader/install
+++ b/projects/Amlogic/bootloader/install
@@ -9,7 +9,7 @@ mkdir -p "${DESTDIR}"
 FIPDIR="$(get_build_dir amlogic-boot-fip)"
 
 case "${UBOOT_SYSTEM}" in
-  box|"")
+  box|mibox4|"")
     # no-op, use vendor bootloader
     ;;
   *)
@@ -25,7 +25,7 @@ rm -rf "${INSTALL}"/usr/share/bootloader/u-boot*
 
 # Install u-boot
 mkdir -p "${INSTALL}/usr/share/bootloader"
-if [ "${UBOOT_SYSTEM}" != "box" ]; then
+if [ "${UBOOT_SYSTEM}" != "box" ] && [ "${UBOOT_SYSTEM}" != "mibox4" ]; then
   if [ -f "${DESTDIR}/u-boot.bin.sd.bin" ]; then
     cp -av "${DESTDIR}/u-boot.bin.sd.bin" "${INSTALL}/usr/share/bootloader"
     # If target/u-boot exists, cache the signed bin
diff --git a/projects/Amlogic/bootloader/mkimage b/projects/Amlogic/bootloader/mkimage
index 282600bd55fe0dbfc1c600c9737d5fff36df28fa..2839e06b3b5623f03fe56e319e438c7d249496eb 100644
--- a/projects/Amlogic/bootloader/mkimage
+++ b/projects/Amlogic/bootloader/mkimage
@@ -69,6 +69,16 @@ case "${UBOOT_SYSTEM}" in
     mkimage_bootini
     mkimage_dtb
     ;;
+  mibox4)
+    # Keep the production image on Xiaomi's early boot chain until the
+    # board-specific mainline BL33 has completed recoverable hardware testing.
+    # Package only its fixed boot configuration and vendor-U-Boot autoscripts.
+    mkimage_uEnv
+    mkimage_autoscripts
+    mkimage_bootini
+    mkimage_extlinux
+    mkimage_dtb
+    ;;
   odroid-n2|odroid-c4)
     mkimage_uboot
     mkimage_extlinux_fdtdir
diff --git a/projects/Amlogic/config/kernel-firmware.dat b/projects/Amlogic/config/kernel-firmware.dat
index 4896c49f9168561d26e5079476a4094d3e0a5e3a..fde7e8cad5483d3e661660cd19467a5879078eee 100644
--- a/projects/Amlogic/config/kernel-firmware.dat
+++ b/projects/Amlogic/config/kernel-firmware.dat
@@ -12,6 +12,7 @@ rtlwifi/rtl8192cufw_TMSC.bin
 rtlwifi/rtl8192cufw.bin
 rtlwifi/rtl8192eu_nic.bin
 rtlwifi/rtl8723bs_nic.bin
+rtw88/rtw8723d_fw.bin
 rtw88/rtw8821c_fw.bin
 rtw88/rtw8822c_fw.bin
 rtw88/rtw8822c_wow_fw.bin
diff --git a/projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0098-LOCAL-arm64-dts-add-xiaomi-mibox4-rtl8723ds.patch b/projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0098-LOCAL-arm64-dts-add-xiaomi-mibox4-rtl8723ds.patch
new file mode 100644
index 0000000000000000000000000000000000000000..e1fc9a8c9b95905620ac41bf26a5888969dc61b6
--- /dev/null
+++ b/projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0098-LOCAL-arm64-dts-add-xiaomi-mibox4-rtl8723ds.patch
@@ -0,0 +1,139 @@
+diff --git a/arch/arm64/boot/dts/amlogic/Makefile b/arch/arm64/boot/dts/amlogic/Makefile
+index 249594fc91d5..029c921ecf1a 100644
+--- a/arch/arm64/boot/dts/amlogic/Makefile
++++ b/arch/arm64/boot/dts/amlogic/Makefile
+@@ -43,6 +43,7 @@ dtb-$(CONFIG_ARCH_MESON) += meson-gxl-s905x-nexbox-a95x.dtb
+ dtb-$(CONFIG_ARCH_MESON) += meson-gxl-s905x-p212.dtb
+ dtb-$(CONFIG_ARCH_MESON) += meson-gxl-s905x-vero4k.dtb
+ dtb-$(CONFIG_ARCH_MESON) += meson-gxlx-s905l-p271.dtb
++dtb-$(CONFIG_ARCH_MESON) += meson-gxlx-mibox4.dtb
+ dtb-$(CONFIG_ARCH_MESON) += meson-gxm-gt1-ultimate.dtb
+ dtb-$(CONFIG_ARCH_MESON) += meson-gxm-khadas-vim2.dtb
+ dtb-$(CONFIG_ARCH_MESON) += meson-gxm-mecool-kiii-pro.dtb
+diff --git a/arch/arm64/boot/dts/amlogic/meson-gxlx-mibox4.dts b/arch/arm64/boot/dts/amlogic/meson-gxlx-mibox4.dts
+new file mode 100644
+index 0000000..660271f
+--- /dev/null
++++ b/arch/arm64/boot/dts/amlogic/meson-gxlx-mibox4.dts
+@@ -0,0 +1,121 @@
++// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
++/*
++ * Xiaomi Mi Box 4 (MDZ-21-AA), derived from the mainline P271 board file.
++ *
++ * The vendor DTB (mibox4_gxl_tf_2g.dtb) is a legacy, monolithic Amlogic
++ * device tree.  Its SoC-wide nodes are already provided by the mainline
++ * meson-gxl*.dtsi files; only board data and properties with mainline
++ * bindings are kept here.  In particular, the vendor multimedia, efuse,
++ * unifykey and aml_wifi nodes are intentionally not copied: those drivers
++ * are not mainline bindings.
++ */
++
++/dts-v1/;
++
++#include "meson-gxl-s905x.dtsi"
++#include "meson-gx-p23x-q20x.dtsi"
++
++/ {
++	compatible = "xiaomi,mibox4", "amlogic,p271", "amlogic,s905l",
++		     "amlogic,meson-gxlx";
++	model = "Xiaomi Mi Box 4 (MDZ-21-AA)";
++
++	/* gxl_tf_2g in the extracted vendor DTB: 2 GiB RAM. */
++	memory@0 {
++		device_type = "memory";
++		reg = <0x0 0x0 0x0 0x80000000>;
++	};
++
++	chosen {
++		stdout-path = "serial0:115200n8";
++	};
++
++	sound {
++		model = "P271";
++	};
++
++	/*
++	 * RTL8723DS power/reset sequencing.
++	 *
++	 * The vendor DT uses the legacy linear GPIO number 0x58, which maps
++	 * to GPIOX_9 on the mainline GXL GPIO controller.
++	 */
++	wifi_pwrseq: wifi-pwrseq {
++		compatible = "mmc-pwrseq-simple";
++		reset-gpios = <&gpio GPIOX_9 GPIO_ACTIVE_LOW>;
++		clocks = <&wifi32k>;
++		clock-names = "ext_clock";
++		post-power-on-delay-ms = <200>;
++	};
++};
++
++/* Mali 450-MP2; interrupt layout is identical to the P271 reference board. */
++&apb {
++	mali: gpu@c0000 {
++		interrupts = <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH>,
++			<GIC_SPI 161 IRQ_TYPE_LEVEL_HIGH>,
++			<GIC_SPI 162 IRQ_TYPE_LEVEL_HIGH>,
++			<GIC_SPI 163 IRQ_TYPE_LEVEL_HIGH>,
++			<GIC_SPI 164 IRQ_TYPE_LEVEL_HIGH>,
++			<GIC_SPI 165 IRQ_TYPE_LEVEL_HIGH>,
++			<GIC_SPI 166 IRQ_TYPE_LEVEL_HIGH>,
++			<GIC_SPI 167 IRQ_TYPE_LEVEL_HIGH>;
++		interrupt-names = "gp", "gpmmu", "pp", "pmu",
++			"pp0", "ppmmu0", "pp1", "ppmmu1";
++	};
++};
++
++/* The Mi Box has no host-facing USB gadget port. */
++&usb {
++	dr_mode = "host";
++};
++
++/* GXLX-specific peripheral compatibles required by mainline drivers. */
++&saradc {
++	compatible = "amlogic,meson-gxlx-saradc", "amlogic,meson-saradc";
++};
++
++&vdec {
++	compatible = "amlogic,gxlx-vdec", "amlogic,gx-vdec";
++};
++
++/* The Mi Box 4 has neither an Ethernet connector nor an SD card slot. */
++&ethmac {
++	status = "disabled";
++};
++
++&sd_emmc_b {
++	status = "disabled";
++};
++
++/*
++ * On-board eMMC and the soldered Wi-Fi SDIO module are enabled by the
++ * meson-gxl base dtsi.  Keep the bus capabilities discovered in the vendor
++ * DTB, using standard MMC bindings only.
++ */
++&sd_emmc_c {
++	status = "okay";
++	bus-width = <8>;
++	non-removable;
++	cap-mmc-highspeed;
++	mmc-hs200-1_8v;
++	mmc-hs400-1_8v;
++};
++
++&sd_emmc_a {
++	status = "okay";
++	bus-width = <4>;
++	non-removable;
++	cap-sd-highspeed;
++	keep-power-in-suspend;
++	mmc-pwrseq = <&wifi_pwrseq>;
++
++	/* SDIO function 1 is the RTL8723DS WLAN device. */
++	rtl8723ds: wifi@1 {
++		reg = <1>;
++		interrupt-parent = <&gpio_intc>;
++		/* vendor GPIO 0x56 = GPIOX_7 = GPIO interrupt 96 */
++		interrupts = <96 IRQ_TYPE_LEVEL_HIGH>;
++		interrupt-names = "host-wake";
++	};
++};
diff --git a/projects/Amlogic/linux/linux.aarch64.conf b/projects/Amlogic/linux/linux.aarch64.conf
index 8617860fc481b570c082a915b1b78d22cbe76b2b..676965cc75808e44c342579611aded9f83f1275e 100644
--- a/projects/Amlogic/linux/linux.aarch64.conf
+++ b/projects/Amlogic/linux/linux.aarch64.conf
@@ -2698,7 +2698,7 @@ CONFIG_RTW88_8822BU=m
 CONFIG_RTW88_8822CS=m
 CONFIG_RTW88_8822CU=m
 # CONFIG_RTW88_8723DE is not set
-# CONFIG_RTW88_8723DS is not set
+CONFIG_RTW88_8723DS=m
 # CONFIG_RTW88_8723CS is not set
 CONFIG_RTW88_8723DU=m
 # CONFIG_RTW88_8821CE is not set
diff --git a/scripts/uboot_helper b/scripts/uboot_helper
index 469374170ef12cfdd9a78c918ae31a4026ab02c7..0ae343a481aa31949c8c767893b3fc1d91dec805 100755
--- a/scripts/uboot_helper
+++ b/scripts/uboot_helper
@@ -204,6 +204,10 @@ devices = \
         'dtb': 'meson-gxl-s905x-libretech-cc.dtb',
         'config': 'libretech-cc_defconfig'
       },
+      'mibox4': {
+        'dtb': 'meson-gxlx-mibox4.dtb',
+        'config': 'p212_defconfig'
+      },
       'nanopi-k2': {
         'dtb': 'meson-gxbb-nanopi-k2.dtb',
         'config': 'nanopi-k2_defconfig'
