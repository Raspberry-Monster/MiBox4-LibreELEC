Subject: [PATCH 2/2] wifi: derive Mi Box 4 MAC from Meson eFuse

---
 ...ice_get_mac_address-to-use-NVMEM.patch | 33 ++++++++++++++
 ...-rtw88-use-mibox4-soc-efuse-wifi-mac.patch | 55 ++++++++++++++++++++++
 2 files changed, 88 insertions(+)
 create mode 100644 projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0099-BACKPORT-ethernet-Extend-device_get_mac_address-to-use-NVMEM.patch
 create mode 100644 projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0100-LOCAL-wifi-rtw88-use-mibox4-soc-efuse-wifi-mac.patch

diff --git a/projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0099-BACKPORT-ethernet-Extend-device_get_mac_address-to-use-NVMEM.patch b/projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0099-BACKPORT-ethernet-Extend-device_get_mac_address-to-use-NVMEM.patch
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0099-BACKPORT-ethernet-Extend-device_get_mac_address-to-use-NVMEM.patch
@@ -0,0 +1,33 @@
+From d2d3f529e7b6ff2aa432b16a2317126621c28058 Mon Sep 17 00:00:00 2001
+From: Stefan Wahren <wahrenst@gmx.net>
+Date: Fri, 12 Sep 2025 16:03:32 +0200
+Subject: [PATCH] ethernet: Extend device_get_mac_address() to use NVMEM
+
+A lot of modern SoCs can store MAC addresses in NVMEM. Extend the generic
+device_get_mac_address() helper to obtain the address from an NVMEM cell
+named "mac-address" when firmware-node properties do not provide one.
+
+Signed-off-by: Stefan Wahren <wahrenst@gmx.net>
+Reviewed-by: Andrew Lunn <andrew@lunn.ch>
+Link: https://patch.msgid.link/20250912140332.35395-3-wahrenst@gmx.net
+Signed-off-by: Jakub Kicinski <kuba@kernel.org>
+---
+ net/ethernet/eth.c | 5 ++++-
+ 1 file changed, 4 insertions(+), 1 deletion(-)
+
+diff --git a/net/ethernet/eth.c b/net/ethernet/eth.c
+index d562db5d04ee..b14228b3f78e 100644
+--- a/net/ethernet/eth.c
++++ b/net/ethernet/eth.c
+@@ -614,5 +614,8 @@ EXPORT_SYMBOL(fwnode_get_mac_address);
+ int device_get_mac_address(struct device *dev, char *addr)
+ {
+-	return fwnode_get_mac_address(dev_fwnode(dev), addr);
++	if (!fwnode_get_mac_address(dev_fwnode(dev), addr))
++		return 0;
++
++	return nvmem_get_mac_address(dev, addr);
+ }
+ EXPORT_SYMBOL(device_get_mac_address);
+--
+2.55.0.windows.3
diff --git a/projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0100-LOCAL-wifi-rtw88-use-mibox4-soc-efuse-wifi-mac.patch b/projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0100-LOCAL-wifi-rtw88-use-mibox4-soc-efuse-wifi-mac.patch
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0100-LOCAL-wifi-rtw88-use-mibox4-soc-efuse-wifi-mac.patch
@@ -0,0 +1,55 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: YuChia Kan <raspberrykan@stu.hqu.edu.cn>
+Date: Fri, 28 Aug 2026 14:00:00 +0800
+Subject: [PATCH] wifi: rtw88: use Mi Box 4 SoC eFuse MAC address
+
+The Mi Box 4 board DTS describes Xiaomi's six-byte mac_wifi eFuse key as a
+standard mac-address NVMEM cell attached to the RTL8723DS SDIO function.
+Make rtw88 consult that board address when the module eFuse is invalid before
+falling back to a random address.
+
+Signed-off-by: YuChia Kan <raspberrykan@stu.hqu.edu.cn>
+---
+ drivers/net/wireless/realtek/rtw88/main.c | 15 +++++++++++++--
+ 1 file changed, 13 insertions(+), 2 deletions(-)
+diff --git a/drivers/net/wireless/realtek/rtw88/main.c b/drivers/net/wireless/realtek/rtw88/main.c
+index c4de5d1..6cc40ed 100644
+--- a/drivers/net/wireless/realtek/rtw88/main.c
++++ b/drivers/net/wireless/realtek/rtw88/main.c
+@@ -3,6 +3,7 @@
+  */
+ 
+ #include <linux/devcoredump.h>
++#include <linux/etherdevice.h>
+ 
+ #include "main.h"
+ #include "regd.h"
+@@ -1974,5 +1975,6 @@ static int rtw_chip_efuse_info_setup(struct rtw_dev *rtwdev)
+ {
+ 	struct rtw_efuse *efuse = &rtwdev->efuse;
++	int mac_ret;
+ 	int ret;
+ 
+ 	mutex_lock(&rtwdev->mutex);
+@@ -2024,8 +2026,17 @@ static int rtw_chip_efuse_info_setup(struct rtw_dev *rtwdev)
+ 	efuse->ext_lna_5g = efuse->lna_type_5g & BIT(3) ? 1 : 0;
+ 
+ 	if (!is_valid_ether_addr(efuse->addr)) {
+-		eth_random_addr(efuse->addr);
+-		dev_warn(rtwdev->dev, "efuse MAC invalid, using random\n");
++		mac_ret = device_get_mac_address(rtwdev->dev, efuse->addr);
++
++		if (mac_ret) {
++			eth_random_addr(efuse->addr);
++			dev_warn(rtwdev->dev,
++				 "efuse and firmware MAC invalid, using random (error: %d)\n",
++				 mac_ret);
++		} else {
++			dev_info(rtwdev->dev,
++				 "using MAC address from firmware\n");
++		}
+ 	}
+ 
+ out_disable:
+--
+2.55.0.windows.3
--
2.55.0.windows.3
