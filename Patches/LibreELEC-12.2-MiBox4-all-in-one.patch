diff --git a/projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0099-LOCAL-wifi-rtw88-use-mibox4-soc-efuse-wifi-mac.patch b/projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0099-LOCAL-wifi-rtw88-use-mibox4-soc-efuse-wifi-mac.patch
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/projects/Amlogic/devices/AMLGX/patches/linux/amlogic-0099-LOCAL-wifi-rtw88-use-mibox4-soc-efuse-wifi-mac.patch
@@ -0,0 +1,55 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: YuChia Kan <raspberrykan@stu.hqu.edu.cn>
+Date: Fri, 28 Aug 2026 14:00:00 +0800
+Subject: [PATCH] wifi: rtw88: use Mi Box 4 SoC eFuse MAC address
+
+The Mi Box 4 board DTS describes Xiaomi's six-byte mac_wifi eFuse key as a
+standard mac-address NVMEM cell attached to the RTL8723DS SDIO function.
+Make rtw88 consult that board address when the module eFuse is invalid before
+falling back to a random address.
+
+Signed-off-by: YuChia Kan <raspberrykan@stu.hqu.edu.cn>
+---
+ drivers/net/wireless/realtek/rtw88/main.c | 15 +++++++++++++--
+ 1 file changed, 13 insertions(+), 2 deletions(-)
+diff --git a/drivers/net/wireless/realtek/rtw88/main.c b/drivers/net/wireless/realtek/rtw88/main.c
+index c4de5d1..6cc40ed 100644
+--- a/drivers/net/wireless/realtek/rtw88/main.c
++++ b/drivers/net/wireless/realtek/rtw88/main.c
+@@ -3,6 +3,7 @@
+  */
+ 
+ #include <linux/devcoredump.h>
++#include <linux/etherdevice.h>
+ 
+ #include "main.h"
+ #include "regd.h"
+@@ -1974,5 +1975,6 @@ static int rtw_chip_efuse_info_setup(struct rtw_dev *rtwdev)
+ {
+ 	struct rtw_efuse *efuse = &rtwdev->efuse;
++	int mac_ret;
+ 	int ret;
+ 
+ 	mutex_lock(&rtwdev->mutex);
+@@ -2024,8 +2026,17 @@ static int rtw_chip_efuse_info_setup(struct rtw_dev *rtwdev)
+ 	efuse->ext_lna_5g = efuse->lna_type_5g & BIT(3) ? 1 : 0;
+ 
+ 	if (!is_valid_ether_addr(efuse->addr)) {
+-		eth_random_addr(efuse->addr);
+-		dev_warn(rtwdev->dev, "efuse MAC invalid, using random\n");
++		mac_ret = device_get_mac_address(rtwdev->dev, efuse->addr);
++
++		if (mac_ret) {
++			eth_random_addr(efuse->addr);
++			dev_warn(rtwdev->dev,
++				 "efuse and firmware MAC invalid, using random (error: %d)\n",
++				 mac_ret);
++		} else {
++			dev_info(rtwdev->dev,
++				 "using MAC address from firmware\n");
++		}
+ 	}
+ 
+ out_disable:
+--
+2.55.0.windows.3
diff --git a/projects/Amlogic/patches/u-boot/u-boot-0003-LOCAL-add-xiaomi-mibox4.patch b/projects/Amlogic/patches/u-boot/u-boot-0003-LOCAL-add-xiaomi-mibox4.patch
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/projects/Amlogic/patches/u-boot/u-boot-0003-LOCAL-add-xiaomi-mibox4.patch
@@ -0,0 +1,459 @@
+diff --git a/arch/arm/dts/meson-gxlx-mibox4-u-boot.dtsi b/arch/arm/dts/meson-gxlx-mibox4-u-boot.dtsi
+new file mode 100644
+index 0000000000000000000000000000000000000000..fe38bcff53170e791d3d834f87e48de174162c0b
+--- /dev/null
++++ b/arch/arm/dts/meson-gxlx-mibox4-u-boot.dtsi
+@@ -0,0 +1,52 @@
++// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
++
++#include "meson-gxl-u-boot.dtsi"
++
++/* Xiaomi BL33 drives both lines high during normal startup. */
++&gpio {
++	power-led-hog {
++		gpio-hog;
++		gpios = <GPIOX_6 GPIO_ACTIVE_HIGH>;
++		output-high;
++		line-name = "mibox4-power-led";
++	};
++};
++
++&gpio_ao {
++	hdmi-usb-5v-hog {
++		gpio-hog;
++		gpios = <GPIOAO_4 GPIO_ACTIVE_HIGH>;
++		output-high;
++		line-name = "mibox4-hdmi-usb-5v";
++	};
++};
++
++/* The hog owns these GPIOs in U-Boot; Linux uses the semantic devices. */
++&hdmi_usb_5v {
++	status = "disabled";
++};
++
++&leds {
++	status = "disabled";
++};
++
++&hdmi_tx {
++	/delete-property/ hdmi-supply;
++};
++
++&usb2_phy0 {
++	/delete-property/ phy-supply;
++};
++
++/* U-Boot does not need to enumerate the soldered SDIO Wi-Fi function. */
++&sd_emmc_a {
++	status = "disabled";
++};
++
++&sd_emmc_c {
++	bootph-all;
++};
++
++&uart_AO {
++	bootph-all;
++};
+diff --git a/board/amlogic/mibox4/Makefile b/board/amlogic/mibox4/Makefile
+new file mode 100644
+index 0000000000000000000000000000000000000000..4027409c2f34e24f1261f08bd68d263dd84f12cf
+--- /dev/null
++++ b/board/amlogic/mibox4/Makefile
+@@ -0,0 +1 @@
++# SPDX-License-Identifier: GPL-2.0+
+diff --git a/configs/mibox4_defconfig b/configs/mibox4_defconfig
+new file mode 100644
+index 0000000000000000000000000000000000000000..00708aec072da00310c33f8213c192f2109c6cf8
+--- /dev/null
++++ b/configs/mibox4_defconfig
+@@ -0,0 +1,54 @@
++CONFIG_ARM=y
++CONFIG_SYS_BOARD="mibox4"
++CONFIG_ARCH_MESON=y
++CONFIG_TEXT_BASE=0x01000000
++CONFIG_NR_DRAM_BANKS=1
