   mv ${PKG_BUILD}/aml-a311d-cc ${PKG_BUILD}/alta
   mv ${PKG_BUILD}/aml-s905d3-cc ${PKG_BUILD}/solitude
+
+  # Mi Box 4 reuses Xiaomi's signed early stages and replaces BL33 with the
+  # freshly built Mainline U-Boot, following the normal build-fip.sh flow.
+  if [ "${UBOOT_SYSTEM}" = "mibox4" ]; then
+    cp -a "${PKG_DIR}/files/mibox4" "${PKG_BUILD}/mibox4"
+  fi
 }
