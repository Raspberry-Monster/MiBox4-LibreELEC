diff --git a/packages/tools/amlogic-boot-fip/files/mibox4/Makefile b/packages/tools/amlogic-boot-fip/files/mibox4/Makefile
new file mode 100644
index 0000000..84c11e0
--- /dev/null
+++ b/packages/tools/amlogic-boot-fip/files/mibox4/Makefile
@@ -0,0 +1,37 @@
+# Mi Box 4 GXL FIP packaging using Xiaomi's signed early-stage wrappers.
+
+O ?= .
+TMP ?= .
+BL33 ?=
+# Reuse the GXL packaging tool shipped in amlogic-boot-fip's P212 directory;
+# keeping it in place avoids duplicating or relocating an upstream asset.
+AMLICRYPT ?= ../p212/aml_encrypt_gxl
+QEMU_LD_PREFIX ?= /usr/x86_64-linux-gnu/
+
+UNAME_M := $(shell uname -m)
+ifneq ($(UNAME_M),x86_64)
+QEMU := qemu-x86_64 -L $(QEMU_LD_PREFIX)
+endif
+
+.PHONY: all clean distclean
+.NOTPARALLEL: ${TMP}/bl33.bin.enc ${O}/u-boot.bin
+
+all: ${O}/u-boot.bin
+
+${TMP}/bl33.bin.enc: ${BL33}
+	${QEMU} ${AMLICRYPT} --bl3enc --input ${BL33} --output $@
+
+${O}/u-boot.bin: bl2.sign bl30.enc bl31.enc ${TMP}/bl33.bin.enc
+	${QEMU} ${AMLICRYPT} --bootmk --output $@ \
+		--bl2 bl2.sign --bl30 bl30.enc --bl31 bl31.enc \
+		--bl33 ${TMP}/bl33.bin.enc
+	test -f ${O}/u-boot.bin.sd.bin
+	dd if=${O}/u-boot.bin of=${O}/u-boot.bin.usb.tpl skip=49152 bs=1
+	dd if=${O}/u-boot.bin of=${O}/u-boot.bin.usb.bl2 bs=49152 count=1
+
+clean:
+	rm -f ${TMP}/bl33.bin.enc
+
+distclean: clean
+	rm -f ${O}/u-boot.bin ${O}/u-boot.bin.sd.bin
+	rm -f ${O}/u-boot.bin.usb.bl2 ${O}/u-boot.bin.usb.tpl
diff --git a/packages/tools/amlogic-boot-fip/files/mibox4/README.md b/packages/tools/amlogic-boot-fip/files/mibox4/README.md
new file mode 100644
index 0000000..600e041
--- /dev/null
+++ b/packages/tools/amlogic-boot-fip/files/mibox4/README.md
@@ -0,0 +1,22 @@
+# Mi Box 4 FIP inputs
+
+This directory mirrors the standard file names used by
+LibreELEC/amlogic-boot-fip for the GXL firmware image package:
+
+- `bl2.sign`, `bl30.enc`, `bl31.enc`: Xiaomi's original signed/encrypted
+  early stages, retained byte-for-byte and used by the production FIP.
+- `bl33.enc`: the original vendor BL33 wrapper, retained as a reference.
+  The build replaces this slot with an encoded Mainline U-Boot BL33.
+- `bl2.bin`, `bl30.bin`, `bl31.bin`, `bl33.bin`: decoded inspection copies.
+- `fip`, `fip.enc`: extracted FIP metadata/payload references.
+- `SHA256SUMS`: hashes of every input.
+
+The Makefile intentionally calls P212's existing `aml_encrypt_gxl` binary.
+That binary is reused only as the GXL FIP packaging tool; Mi Box 4 keeps its
+own defconfig, device tree and board implementation, and does not reuse P212
+U-Boot board code.
+
+The files are copied from `bootloader/mibox4-stock/extracted`. The LibreELEC
+board Makefile follows the `LibreELEC/amlogic-boot-fip` interface and emits a
+complete `u-boot.bin`/`u-boot.bin.sd.bin` boot container. The extracted stage
+files must never be written to eMMC individually.
